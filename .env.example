GOOGLE_API_KEY=
GENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta

GENAI_MODEL_CHEAP=gemini-3.5-flash-lite
GENAI_MODEL_STANDARD=gemini-3.6-flash
GENAI_MODEL_STRONG=gemini-2.5-pro
GENAI_MAX_OUTPUT_TOKENS=32768
GENAI_TIMEOUT_SECONDS=180
PROMPTS_DIR=prompts
REFERENCE_TABLES_DIR=reference_data
QDRANT_PATH=data/qdrant_exim
QDRANT_COLLECTION=atg_aa_codes
REFERENCE_DIR=data/reference/nomenclature_exim
REFERENCE_SNAPSHOT_DIR=data/reference/snapshots
NOMENCLATURE_API_BASE=https://exim.src.am/api/govtech
NOMENCLATURE_MAX_NODE_ID=21400
NOMENCLATURE_CRAWL_WORKERS=14
CLASSIFY_EMBEDDING_MODEL=models/gemini-embedding-001
CLASSIFY_EMBEDDING_DIM=768

# M15 Service Edge — dev-only, single-process. No real auth, quota or persistence yet.
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8420
SERVICE_DEV_TOKEN=local-dev-only-change-me

# Public marketing / lead-capture site (web/), read by web/deepclare_web/config.py.
WEB_PORT=8090
WEB_COMPANY_LEGAL_NAME=changeme      # registered legal entity name (e.g. «ՕՐԻՆԱԿ» ՍՊԸ)
WEB_COMPANY_UNN=changeme             # ՀՎՀՀ (tax code), shown in the site footer
WEB_COMPANY_ADDRESS=changeme         # legal address, shown on the contact page
WEB_CONTACT_EMAIL=contact@deepclare.am # public support e-mail
WEB_CONTACT_PHONE=                   # public phone; empty hides the row
WEB_TELEGRAM_LINK=                   # e.g. https://t.me/yourchannel; empty hides the row
WEB_BASE_URL=http://localhost:8090   # public URL once the domain is mapped
WEB_CHROME_STORE_URL=                # Chrome Web Store listing URL; empty keeps the built-in default
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR — read by web/deepclare_web/logging_config.py
