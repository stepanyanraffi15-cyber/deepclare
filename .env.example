# DeepClare configuration.
#
#   cp .env.example .env      then set GOOGLE_API_KEY
#
# Only GOOGLE_API_KEY is required. Every other line below is a DEFAULT already in
# force — uncomment one only to override it. Configuration is read once at startup
# and an invalid value fails immediately, naming itself.

# --- required ---------------------------------------------------------------
GOOGLE_API_KEY=

# --- provider ---------------------------------------------------------------
#GENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# One model per tier. A stage names a tier, never a model id, so swapping a model
# is a configuration change and the trace still records what answered.
#GENAI_MODEL_CHEAP=gemini-3.5-flash-lite       # page classify, column labelling
#GENAI_MODEL_STANDARD=gemini-3.6-flash         # vision reading, descriptions, narrowing
#GENAI_MODEL_STRONG=gemini-2.5-pro             # the final code pick and its verification

# Must clear the largest expected answer PLUS the reasoning spent reaching it, which
# is counted separately. Exhausting it truncates the answer mid-JSON and the call fails.
#GENAI_MAX_OUTPUT_TOKENS=32768
#GENAI_TIMEOUT_SECONDS=180

# --- embeddings: locked, not chosen -----------------------------------------
# The vector collection was built with this pairing. A different model or width does
# not align with those vectors — retrieval returns confident nonsense rather than
# failing — so changing either means rebuilding the collection.
#CLASSIFY_EMBEDDING_MODEL=models/gemini-embedding-001
#CLASSIFY_EMBEDDING_DIM=768

# --- where things live ------------------------------------------------------
# Defaults are relative to the repository, so a normal checkout needs none of them.
#PROMPTS_DIR=prompts
#REFERENCE_TABLES_DIR=reference_data
#REFERENCE_DIR=data/reference/nomenclature_exim
#REFERENCE_SNAPSHOT_DIR=data/reference/snapshots
#QDRANT_PATH=data/qdrant_exim
#QDRANT_COLLECTION=atg_aa_codes

# --- acquiring the nomenclature ---------------------------------------------
# Enumerated by node id: the paged listing endpoint reports 10,000 rows against an
# id space past 21,000, so anything built on it silently misses most of the tree.
#NOMENCLATURE_API_BASE=https://exim.src.am/api/govtech
#NOMENCLATURE_MAX_NODE_ID=21400
#NOMENCLATURE_CRAWL_WORKERS=14
