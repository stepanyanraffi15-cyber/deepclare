# DeepClare configuration.
#
# Copy to .env and fill in. Every variable below is read once at startup into a
# typed settings object; a missing required variable fails immediately, naming
# itself, rather than halfway through a run.
#
#   cp .env.example .env
#
# Nothing here has a default that points at a real endpoint, key, or dataset.

# API key for the generative model provider. Required.
GOOGLE_API_KEY=

# Base URL of the provider's REST API. Required — no endpoint is hardcoded.
GENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta
