# DeepClare configuration.
#
# Copy to .env and fill in. Every variable below is read once at startup into a
# typed settings object; a missing required variable fails immediately, naming
# itself, rather than halfway through a run.
#
#   cp .env.example .env
#
# Nothing here has a default that points at a real endpoint, key, or dataset.

# API key for the generative model provider. Required.
GOOGLE_API_KEY=

# Base URL of the provider's REST API. Required — no endpoint is hardcoded.
GENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# One model id per tier. A stage names a tier, never a model id, so a model swap is a
# configuration change and the trace can pin what answered.
#   cheap    — label-emitting calls: page classification, header read, column labelling
#   standard — reading and writing: vision extraction, enrichment, description,
#              chapter/heading narrowing, harmonization
#   strong   — calls that turn on a material or legal distinction: final code pick,
#              verification
GENAI_MODEL_CHEAP=gemini-3.5-flash-lite
GENAI_MODEL_STANDARD=gemini-3.6-flash
GENAI_MODEL_STRONG=gemini-2.5-pro

# Ceiling on generated tokens per call. It must clear the largest expected answer plus
# whatever the model spends on reasoning, which is counted and billed separately:
# exhausting it truncates the answer mid-JSON and the call fails rather than retrying.
GENAI_MAX_OUTPUT_TOKENS=32768

# Per-call timeout in seconds. There is no retry anywhere on the run path, so this is
# the only bound on how long one model call can hold a run.
GENAI_TIMEOUT_SECONDS=180

# Directory holding the prompt files. Every prompt is a file declaring its own name and
# version, with named {{placeholders}}; none is built as a string in Python. See that
# directory's README for the format. Relative paths resolve against the working
# directory and must exist at startup.
PROMPTS_DIR=prompts

# Directory holding the curated lookup tables assembly resolves against: units and their
# aliases, countries, packing codes, the Armenian nouns that count packages, the size
# vocabulary. Small, hand-curated, tracked in git — unlike the reference-data layer
# below — and read as data so a correction is not a release. Must exist at startup.
REFERENCE_TABLES_DIR=reference_data

# --- reference data ---------------------------------------------------------
# The vector collection over commodity codes, in embedded on-disk mode, and the
# tree artifact that gives those codes their names, units and taxonomic paths.
# Both are large derived objects; a checkout does not contain them.
QDRANT_PATH=data/qdrant_exim
QDRANT_COLLECTION=atg_aa_codes
REFERENCE_DIR=data/reference/nomenclature_exim

# Raw acquisition snapshots, retained so re-deriving the tree never re-acquires it.
REFERENCE_SNAPSHOT_DIR=data/reference/snapshots

# The government open-data API the nomenclature is acquired from. It is enumerated
# by node id: the paged listing endpoint silently caps at 10,000 rows against an id
# space past 21,000, so anything built on it misses most of the tree with no error.
NOMENCLATURE_API_BASE=https://exim.src.am/api/govtech
NOMENCLATURE_MAX_NODE_ID=21400
NOMENCLATURE_CRAWL_WORKERS=14

# --- embeddings -------------------------------------------------------------
# Locked to whatever the vector collection was built with. Changing either value
# invalidates every vector in the collection and forces a full re-embed.
CLASSIFY_EMBEDDING_MODEL=models/gemini-embedding-001
CLASSIFY_EMBEDDING_DIM=768
