# DeepClare configuration.
#
# Copy to .env and fill in. Every variable below is read once at startup into a
# typed settings object; a missing required variable fails immediately, naming
# itself, rather than halfway through a run.
#
#   cp .env.example .env
#
# Nothing here has a default that points at a real endpoint, key, or dataset.

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------

# API key for the generative + embedding provider. Required.
GOOGLE_API_KEY=

# Base URL of the provider's REST API. Required — no endpoint is hardcoded.
GENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------------
# Embeddings — the symmetry contract
# ---------------------------------------------------------------------------
# Dossier 11 §2 states a hard invariant: the build side and the query side must
# use the SAME model and the SAME dimensionality, or the vectors do not align.
# Changing either of these invalidates an existing vector collection and forces
# a full re-embed. They are configuration, not code, so that the pairing is
# recorded per run and pinned in the trace.

CLASSIFY_EMBEDDING_MODEL=models/gemini-embedding-001
CLASSIFY_EMBEDDING_DIM=768

# The canonical text structure the index was built with. Recorded per run so an
# accuracy change is attributable to the text structure and not only the model.
# Changing this string means the index must be rebuilt.
EMBEDDING_TEXT_STRUCTURE=v1-en-broad-to-specific-emdash

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
# Qdrant in embedded on-disk mode. QDRANT_PATH is a local directory.
QDRANT_PATH=data/qdrant_exim
QDRANT_COLLECTION=atg_aa_codes

# ---------------------------------------------------------------------------
# Reference data
# ---------------------------------------------------------------------------

# Where the built nomenclature artifact lives (metadata, not vectors).
NOMENCLATURE_ARTIFACT_PATH=data/reference/nomenclature

# Raw acquisition snapshot. Retained so re-deriving never re-acquires
# (dossier 11 §5).
NOMENCLATURE_SNAPSHOT_PATH=data/reference/snapshots

# The government open-data API the nomenclature is crawled from.
NOMENCLATURE_API_BASE=https://exim.src.am/api/govtech

# Crawl bounds. The id space is enumerated because the paged listing endpoint
# silently caps (dossier 11 §D1 "the crawl hazard"). Give the ceiling headroom
# above the highest observed id.
NOMENCLATURE_CRAWL_MAX_ID=22000
NOMENCLATURE_CRAWL_WORKERS=12
NOMENCLATURE_CRAWL_TIMEOUT_SECONDS=25

# The officially published count of active 10-digit codes, used by the build's
# sanity gate to catch a truncated crawl. Update when the authority publishes a
# new nomenclature vintage.
NOMENCLATURE_EXPECTED_LEAF_COUNT=13289
NOMENCLATURE_LEAF_COUNT_TOLERANCE=200
