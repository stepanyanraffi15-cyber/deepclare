# Transferred material pending review (the handoff dossier). Unanchored on purpose: it
# is what excludes docs/handoff/, the specification, from version control.
handoff/

# Reference data and corpora: large, untracked by design.
# See dossier file 11 §0.2 — a clone never contains the reference-data layer.
data/

# Secrets
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local tooling state. Ignored here rather than only in a machine-local exclude file, so
# a second clone does not start tracking them.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Run output: a drafted declaration is a document about somebody's shipment.
out/

# Build artifacts
*.sqlite
*.db
build/
dist/
